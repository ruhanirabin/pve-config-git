BOT_TOKEN=
CHAT_ID=

REPO_DIR=/root/pve-config
REPO_BRANCH=main
GIT_REMOTE_URL=
GIT_COMMIT_NAME=
GIT_COMMIT_EMAIL=
# Overall limit per Git/SSH network command (1-3600 seconds).
GIT_TIMEOUT_SECONDS=60
# Comma-separated absolute paths. Review contents for credentials first.
BACKUP_INCLUDE_EXTRA=
BACKUP_LOCK_TIMEOUT_SECONDS=120

WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_BEARER_TOKEN=
WEBHOOK_EVENTS=install,doctor,backup,shutdown
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_RETRIES=3

PCG_LOG_RETENTION_DAYS=14
BACKUP_LOG_RETENTION_DAYS=
TELEGRAM_LOG_RETENTION_DAYS=
BOOT_NOTIFY_LOG_RETENTION_DAYS=
SHUTDOWN_LOG_RETENTION_DAYS=

AGENT_UPDATE_CHANNEL=stable
AGENT_UPDATE_SOURCE=
