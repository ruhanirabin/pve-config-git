[Unit]
Description=PCG (Proxmox Config Git) - Run config backup

[Service]
Type=oneshot
Environment=PCG_BACKUP_ENTRYPOINT=systemd
EnvironmentFile=/root/.pcg-agent.env
ExecStart=/usr/local/bin/pcg-backup-config.sh
TimeoutStartSec=600
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
